@baseUrl = {{$dotenv BASE_URL}}

###
# @name createApiKey
# @prompt name
# @prompt phone
POST {{baseUrl}}/v1/examples HTTP/1.1
Accept: application/json
Content-Type: application/json

{
  "name": "{{name}}",
  "phone": "{{phone}}"
}

###
# @name createManyApiKey
# @prompt name1
# @prompt phone1
# @prompt name2
# @prompt phone2
POST {{baseUrl}}/v1/examples/create-many HTTP/1.1
Accept: application/json
Content-Type: application/json

[
  {
    "name": "{{name1}}",
    "phone": "{{phone1}}"  
  },
  {
    "name": "{{name2}}",
    "phone": "{{phone2}}"  
  }
]

###
# @name retrieveAllApiKey
GET {{baseUrl}}/v1/examples HTTP/1.1
Accept: application/json
Content-Type: application/json

###
# @name retrieveApiKey
# @prompt id
GET {{baseUrl}}/v1/examples/{{id}} HTTP/1.1
Accept: application/json
Content-Type: application/json

###
# @name updateApiKey
# @prompt id
# @prompt name
# @prompt phone
PATCH {{baseUrl}}/v1/examples/{{id}} HTTP/1.1
Accept: application/json
Content-Type: application/json

{
  "name": "{{name}}",
  "phone": "{{phone}}"
}

###
# @name updateManyApiKey
# @prompt name
# @prompt phone
POST {{baseUrl}}/v1/examples/update-many HTTP/1.1
Accept: application/json
Content-Type: application/json

{
  "filter": {
    "name": "{{name}}"
  },
  "data": {
    "phone": "{{phone}}"
  }
}

###
# @name deleteApiKey
# @prompt id
DELETE {{baseUrl}}/v1/examples/{{id}} HTTP/1.1
Accept: application/json
Content-Type: application/json

###
# @name deleteManyApiKey
# @prompt id1
# @prompt id2
POST {{baseUrl}}/v1/examples/delete-many HTTP/1.1
Accept: application/json
Content-Type: application/json

{
  "ids": ["{{id1}}","{{id2}}"]
}

###
# @name createTransactionApiKey
# @prompt name1
# @prompt phone1
# @prompt name2
# @prompt phone2
POST {{baseUrl}}/v1/examples/transaction HTTP/1.1
Accept: application/json
Content-Type: application/json

{
  "data1": {
    "name": "{{name1}}",
    "phone": "{{phone1}}"  
  },
  "data2": {
    "name": "{{name2}}",
    "phone": "{{phone2}}"  
  }
}