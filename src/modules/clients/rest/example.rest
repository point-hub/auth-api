@baseUrl = {{$dotenv BASE_URL}}

###
# @name createClient
# @prompt name
# @prompt phone
POST {{baseUrl}}/v1/clients HTTP/1.1
Accept: application/json
Content-Type: application/json

{
  "name": "{{name}}",
  "phone": "{{phone}}"
}

###
# @name createManyClient
# @prompt name1
# @prompt phone1
# @prompt name2
# @prompt phone2
POST {{baseUrl}}/v1/clients/create-many HTTP/1.1
Accept: application/json
Content-Type: application/json

[
  {
    "name": "{{name1}}",
    "phone": "{{phone1}}"  
  },
  {
    "name": "{{name2}}",
    "phone": "{{phone2}}"  
  }
]

###
# @name retrieveAllClient
GET {{baseUrl}}/v1/clients HTTP/1.1
Accept: application/json
Content-Type: application/json

###
# @name retrieveClient
# @prompt id
GET {{baseUrl}}/v1/clients/{{id}} HTTP/1.1
Accept: application/json
Content-Type: application/json

###
# @name updateClient
# @prompt id
# @prompt name
# @prompt phone
PATCH {{baseUrl}}/v1/clients/{{id}} HTTP/1.1
Accept: application/json
Content-Type: application/json

{
  "name": "{{name}}",
  "phone": "{{phone}}"
}

###
# @name updateManyClient
# @prompt name
# @prompt phone
POST {{baseUrl}}/v1/clients/update-many HTTP/1.1
Accept: application/json
Content-Type: application/json

{
  "filter": {
    "name": "{{name}}"
  },
  "data": {
    "phone": "{{phone}}"
  }
}

###
# @name deleteClient
# @prompt id
DELETE {{baseUrl}}/v1/clients/{{id}} HTTP/1.1
Accept: application/json
Content-Type: application/json

###
# @name deleteManyClient
# @prompt id1
# @prompt id2
POST {{baseUrl}}/v1/clients/delete-many HTTP/1.1
Accept: application/json
Content-Type: application/json

{
  "ids": ["{{id1}}","{{id2}}"]
}

###
# @name createTransactionClient
# @prompt name1
# @prompt phone1
# @prompt name2
# @prompt phone2
POST {{baseUrl}}/v1/clients/transaction HTTP/1.1
Accept: application/json
Content-Type: application/json

{
  "data1": {
    "name": "{{name1}}",
    "phone": "{{phone1}}"  
  },
  "data2": {
    "name": "{{name2}}",
    "phone": "{{phone2}}"  
  }
}